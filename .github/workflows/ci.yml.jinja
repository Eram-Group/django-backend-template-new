name: CI

on:
  pull_request:
    branches: ['main']
  push:
    branches: ['main']

permissions:
  contents: read

concurrency:
  group: ci-{% raw %}${{ github.head_ref || github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  # Everything host-runnable, mirroring the local gates exactly.
  fast:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      DJANGO_SETTINGS_MODULE: config.settings.local
    services:
      postgres:
{%- if database == "postgis" %}
        image: imresamu/postgis:18-3.6
{%- else %}
        image: postgres:18
{%- endif %}
        env:
          POSTGRES_DB: backend
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U postgres -d backend"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    steps:
      - uses: actions/checkout@v7

      - uses: ./.github/actions/setup-python-env

      - uses: extractions/setup-just@v3
{%- if database == "postgis" %}

      # GeoDjango loads GDAL/GEOS through ctypes on the runner host (pytest
      # runs outside Docker here); the image job gets them from the Dockerfile.
      - name: Install GDAL and GEOS
        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends libgdal-dev libgeos-dev
{%- endif %}

      # Env has no code defaults by design - the example IS the CI config.
      - name: Bootstrap env file
        run: cp .env.example .env

      # The gate list lives in the justfile (`just gates`), so local runs, this
      # job and the template's generated-project CI stay identical.
      - name: Gates (lint, mypy, lockfile, migrations, tests, OpenAPI)
        run: just gates

  # CDK app: synth without credentials, template assertions, cfn-lint.
  infra:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7

      - uses: ./.github/actions/setup-python-env
        with:
          working-directory: infra

      - uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: infra/package-lock.json

      - uses: extractions/setup-just@v3

      - name: Install the pinned CDK CLI
        run: npm ci
        working-directory: infra

      - name: Gates (synth, template assertions, cfn-lint)
        run: just infra-gates

  # Prod-image build + boot with the production settings module: the release
  # step, then the web process answering its probes.
  image:
    # The deploy workflows build linux/arm64 (Graviton Fargate): smoke the
    # same architecture, or an arm64-only wheel/library gap ships unseen.
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 20
    services:
      postgres:
{%- if database == "postgis" %}
        image: imresamu/postgis:18-3.6
{%- else %}
        image: postgres:18
{%- endif %}
        env:
          POSTGRES_DB: backend
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U postgres -d backend"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    steps:
      - uses: actions/checkout@v7

      - uses: docker/setup-buildx-action@v4

      - name: Build image (GHA layer cache)
        uses: docker/build-push-action@v7
        with:
          context: .
          load: true
          tags: backend:local
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - uses: ./.github/actions/image-smoke
        with:
          image: backend:local
