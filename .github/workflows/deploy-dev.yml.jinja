{% raw %}# Merge to main: build the deploy artifact, roll it out to dev (release task
# -> web -> worker, see ecs-deploy.yml), then sync the OpenAPI spec to Apidog.
# Every variable is expected to exist (docs/DEPLOYMENT.md bootstrap) - a
# missing one fails the run.

name: Deploy dev

on:
  push:
    branches: ['main']

permissions:
  id-token: write
  contents: read

# Never cancel a mid-flight ECS rollout; GitHub queues one pending run per
# group and supersedes the rest, so the newest sha always deploys next.
concurrency:
  group: deploy-dev
  cancel-in-progress: false

jobs:
  # Native arm64 runner: every Fargate task definition is ARM64 (Graviton,
  # ~20% cheaper) and a native build beats QEMU emulation by minutes.
  build:
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 20
    outputs:
      image: ${{ steps.ecr.outputs.registry }}/${{ vars.AWS_ECR_REPOSITORY }}:${{ github.sha }}
    steps:
      - uses: actions/checkout@v7

      - name: Assume deploy role via OIDC
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: ${{ vars.AWS_OIDC_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}

      - name: Login to ECR
        id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      - uses: docker/setup-buildx-action@v4

      - name: Build and push
        uses: docker/build-push-action@v7
        with:
          context: .
          platforms: linux/arm64
          push: true
          tags: ${{ steps.ecr.outputs.registry }}/${{ vars.AWS_ECR_REPOSITORY }}:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  deploy:
    needs: build
    uses: ./.github/workflows/ecs-deploy.yml
    with:
      environment: dev
      image: ${{ needs.build.outputs.image }}
      sha: ${{ github.sha }}

  # Apidog mirrors what runs in dev: sync after a successful deploy.
  apidog:
    needs: deploy
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      DJANGO_SETTINGS_MODULE: config.settings.local
    steps:
      - uses: actions/checkout@v7

      - uses: ./.github/actions/setup-python-env

      # Env has no code defaults by design - the example IS the CI config.
      - name: Bootstrap env file
        run: cp .env.example .env

      # --api is required: the instance mounts at /api/v1/, not /api/. The
      # merge folds allauth's auth endpoints into ONE spec.
      - name: Export OpenAPI schema
        run: |
          uv run manage.py export_openapi_schema --api config.api.v1.api --output openapi.json
          uv run manage.py merge_auth_openapi --input openapi.json --server-url "${{ vars.APIDOG_SERVER_URL }}"

      # Code is the source of truth - matching Apidog endpoints get overwritten.
      - name: Sync to Apidog
        env:
          APIDOG_ACCESS_TOKEN: ${{ secrets.APIDOG_ACCESS_TOKEN }}
        run: |
          jq -n --rawfile spec openapi.json \
            '{input: $spec, options: {endpointOverwriteBehavior: "OVERWRITE_EXISTING"}}' \
          | curl -fsS "https://api.apidog.com/v1/projects/${{ vars.APIDOG_PROJECT_ID }}/import-openapi" \
              -H "Authorization: Bearer ${APIDOG_ACCESS_TOKEN}" \
              -H "X-Apidog-Api-Version: 2024-03-28" \
              -H "Content-Type: application/json" \
              --data @-{% endraw %}
