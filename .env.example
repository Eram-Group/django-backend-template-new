# ============================================================================
# Environment configuration - consumed exclusively by config/env.py.
# ALL fields are required with no code defaults: copy this file to .env for
# local development (just bootstrap does this for you); deployed environments
# provide the same keys via ECS task-definition env vars / Secrets Manager.
# A missing key fails at boot, listing every missing field at once.
# Empty value = unset (feature off for the optional X|None fields).
# Comma-separated lists: VALUE_A,VALUE_B (no JSON).
# ============================================================================

# --- Core -------------------------------------------------------------------
# local | staging | production
ENVIRONMENT=local
SECRET_KEY=insecure-local-only-secret-key
# Old keys during rotation, comma-separated
SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=localhost,127.0.0.1
# Admin mounted at this path (randomize outside local!)
ADMIN_URL=admin/

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend
# psycopg native pool knobs (production pairs them with CONN_MAX_AGE=0)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10.0
DB_POOL_MAX_LIFETIME=3600.0
DB_POOL_MAX_IDLE=600.0

# --- Tasks --------------------------------------------------------------------
# true = run tasks inline (local dev convenience, no worker needed)
# false = queue to Postgres; drain with `manage.py db_worker` (deployed envs)
TASKS_IMMEDIATE=true

# --- Superuser bootstrap (createsuperuser --noinput) -------------------------
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# --- Auth toggles -------------------------------------------------------------
# Signup kill-switch (adapter is_open_for_signup)
ACCOUNT_ALLOW_REGISTRATION=true
# Admin login via allauth email-OTP instead of password (optional hardening)
SECURE_ADMIN_LOGIN=false

# --- Frontend / cross-origin --------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
# Feeds CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS, comma-separated
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
# Set to the parent domain (e.g. .example.com) for subdomain cookie auth
COOKIE_DOMAIN=

# --- OAuth providers (leave empty to disable a provider in local) -------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# base64 of the .p8 private key PEM (multiline-safe transport)
APPLE_OAUTH_PRIVATE_KEY_B64=

# --- Email --------------------------------------------------------------------
DEFAULT_FROM_EMAIL=noreply@localhost
# Mailpit (compose) in local dev; SES handles production via Anymail
EMAIL_HOST=localhost
EMAIL_PORT=1025

# --- AWS (S3 static/media, SES email) - required in staging/production --------
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# CloudFront distribution domain in front of the bucket
AWS_S3_CUSTOM_DOMAIN=
AWS_SES_REGION=

# --- Observability - SENTRY_DSN required in staging/production ----------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
