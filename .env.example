# ============================================================================
# Environment configuration - consumed exclusively by config/env.py.
# ALL fields are required with no code defaults: copy this file to .env for
# local development (just bootstrap does this for you); deployed environments
# provide the same keys via ECS task-definition env vars / Secrets Manager.
# A missing key fails at boot, listing every missing field at once.
# Empty value = unset (feature off for the optional X|None fields).
# Comma-separated lists: VALUE_A,VALUE_B (no JSON).
# ============================================================================

# --- Core -------------------------------------------------------------------
# local | dev | production
ENVIRONMENT=local
SECRET_KEY=insecure-local-only-secret-key
# Old keys during rotation, comma-separated
SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=localhost,127.0.0.1
# Admin mounted at this path (randomize outside local!)
ADMIN_URL=admin/

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend
# psycopg native pool knobs (production pairs them with CONN_MAX_AGE=0)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10.0
DB_POOL_MAX_LIFETIME=3600.0
DB_POOL_MAX_IDLE=600.0

# --- Tasks --------------------------------------------------------------------
# true = run tasks inline (local dev convenience, no worker needed)
# false = queue to Postgres; drain with `manage.py db_worker` (deployed envs)
TASKS_IMMEDIATE=true

# --- Superuser bootstrap (createsuperuser --noinput) -------------------------
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# --- Auth toggles -------------------------------------------------------------
# Signup kill-switch (adapter is_open_for_signup)
ACCOUNT_ALLOW_REGISTRATION=true
# Admin login via allauth email-OTP instead of password (optional hardening)
SECURE_ADMIN_LOGIN=false

# --- Frontend / cross-origin --------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
# Feeds CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS, comma-separated
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
# Set to the parent domain (e.g. .example.com) for subdomain cookie auth
COOKIE_DOMAIN=

# --- OAuth providers (leave empty to disable a provider in local) -------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# base64 of the .p8 private key PEM (multiline-safe transport)
APPLE_OAUTH_PRIVATE_KEY_B64=

# --- Email --------------------------------------------------------------------
DEFAULT_FROM_EMAIL=noreply@localhost
# Mailpit (compose) in local dev; SES handles production via Anymail
EMAIL_HOST=localhost
EMAIL_PORT=1025

# --- AWS (S3 static/media, SES email) - required in dev/production ------------
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# CloudFront distribution domain in front of the bucket
AWS_S3_CUSTOM_DOMAIN=
AWS_SES_REGION=

# --- Observability - SENTRY_DSN required in dev/production --------------------
SENTRY_DSN=
# Git sha of the deployed code - CD injects this into the task definition;
# leave empty locally (errors then carry no release tag)
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Notifications: FCM push + SMS (empty = provider not configured) -----------
# base64 of the Firebase service-account JSON. Keep the value empty and any
# note on its own line: env_ignore_empty makes `FOO=` mean unset, but a
# trailing comment becomes the VALUE and defeats the not-configured guards.
FIREBASE_CREDENTIALS_B64=
OURSMS_API_KEY=
OURSMS_SENDER=
SMSMISR_USERNAME=
SMSMISR_PASSWORD=
SMSMISR_SENDER=

# --- Payments: Tap SAR / Paymob EGP (empty = gateway not configured) -----------
# Same currency -> gateway mapping in every environment; these keys pick the
# mode: TEST-mode keys locally (webhooks via a tunnel, e.g. `ngrok http 8000`
# with BACKEND_BASE_URL set to the tunnel URL), live keys when deployed.
# Absolute base URL of THIS backend - gateways call the webhook here
BACKEND_BASE_URL=http://localhost:8000
TAP_SECRET_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# HMAC secret from the Paymob dashboard (webhook signature verification)
PAYMOB_HMAC_SECRET=
# Paymob integration ids offered at checkout, comma-separated
PAYMOB_INTEGRATION_IDS=
# Card-on-File integration id for one-click saved-card checkout (empty = fall
# back to PAYMOB_INTEGRATION_IDS, which is what Paymob test mode expects)
PAYMOB_COF_INTEGRATION_ID=
# MOTO integration id for server-side (MIT) saved-card charges (empty = MIT
# charges refused on paymob)
PAYMOB_MOTO_INTEGRATION_ID=
