# Build context allowlist-by-exclusion: keep the context minimal so stray
# local files never change image content.

# VCS / IDE / CI meta
.git
.github
.gitignore
.gitattributes
.editorconfig
.idea
.pre-commit-config.yaml

# Environments & secrets (env vars come from ECS/compose, never the image)
.env
.env.*
.venv

# Python / test / tool caches
**/__pycache__
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Local infra & docs (not part of the image)
docker-compose*.yml
compose.yaml
Dockerfile
justfile
README.md
PLAN.md
TODO.json
docs
infra

# Reference material (never ship)

# Local runtime artifacts (produced by release step / runserver)
staticfiles
media
